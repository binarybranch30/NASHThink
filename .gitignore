# Sarthink Gitignore

# Data & Personal Exports
archive/
archive/*
incoming/
processed_data/
config/identity_map.json
config/llm_profiles.json
config/workspaces.json
.env
.env.*
!.env.example

# Raw Data Traces & Databases
*.js
*.jsonl
*.csv
*.db
*.sqlite

# Archives & Media
*.zip
*.tar
*.tar.gz
*.gz
*.mp4
*.mov
*.avi
graph-thing.mp4

# Cache & Metadata
.venv/
.cache/
context_cache.json
users.jsonl
__pycache__/
*.pyc

# IDEs & System
.vscode/
.idea/
.DS_Store

# Temporary & Legacy Folders
context/reddit/Reddit_Context_Archive (Copy)
context/reddit/Reddit_Context_Archive
context/reddit/addn.py
context/reddit/test.py

# Local LLM (llama.cpp binaries, GGUF models, server logs)
.tools/
models/
*.gguf
logs/
output/

# The fictional sample archive (Aarav Mehta) is safe to publish: keep its exports despite the rules above
!demo/sample_archive/**

# Reminders: local settings (config/reminders.json.example is the template); stores and Google tokens
# live under processed_data/reminders/, already ignored above
config/reminders.json
